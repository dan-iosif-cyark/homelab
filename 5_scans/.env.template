# Rendered to .env with `op inject`. Secrets are op:// references into the
# Homelab vault; everything else is a literal.
APPDATA=/mnt/user/appdata
DATA=/mnt/user/data
TZ=Europe/London

PAPERLESS_SECRET_KEY=op://Homelab/PAPERLESS_SECRET_KEY/password
# The OAuth2 provider created for Paperless-ngx in Authentik
PAPERLESS_OIDC_CLIENT_ID=op://Homelab/PAPERLESS_OIDC/username
PAPERLESS_OIDC_CLIENT_SECRET=op://Homelab/PAPERLESS_OIDC/password
