# Rendered to .env with `op inject`. Secrets are op:// references into the
# Homelab vault; everything else is a literal.
APPDATA=/mnt/user/appdata

AUTHENTIK_SECRET_KEY=op://Homelab/AUTHENTIK_SECRET_KEY/password
AUTHENTIK_PG_PASS=op://Homelab/AUTHENTIK_PG_PASS/password
# Postmark SMTP credentials
AUTHENTIK_EMAIL_USERNAME=op://Homelab/AUTHENTIK_EMAIL/username
AUTHENTIK_EMAIL_PASSWORD=op://Homelab/AUTHENTIK_EMAIL/password

# The OAuth2 provider created for Vaultwarden in Authentik
VAULTWARDEN_SSO_CLIENT_ID=op://Homelab/VAULTWARDEN_SSO/username
VAULTWARDEN_SSO_CLIENT_SECRET=op://Homelab/VAULTWARDEN_SSO/password
