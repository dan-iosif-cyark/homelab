# Rendered to .env with `op inject`. Secrets are op:// references into the
# Homelab vault; everything else is a literal.
APPDATA=/mnt/user/appdata
TZ=Europe/London

# The OAuth2 providers created in Authentik for each app
ACTUAL_OIDC_CLIENT_ID=op://Homelab/ACTUAL_OIDC/username
ACTUAL_OIDC_CLIENT_SECRET=op://Homelab/ACTUAL_OIDC/password
RADICALE_OIDC_CLIENT_ID=op://Homelab/RADICALE_OIDC/username
RADICALE_OIDC_CLIENT_SECRET=op://Homelab/RADICALE_OIDC/password
OUTLINE_OIDC_CLIENT_ID=op://Homelab/OUTLINE_OIDC/username
OUTLINE_OIDC_CLIENT_SECRET=op://Homelab/OUTLINE_OIDC/password

# Each is `openssl rand -hex 32`
OUTLINE_SECRET_KEY=op://Homelab/OUTLINE_SECRET_KEY/password
OUTLINE_UTILS_SECRET=op://Homelab/OUTLINE_UTILS_SECRET/password
OUTLINE_PG_PASS=op://Homelab/OUTLINE_PG_PASS/password
