# Rendered to .env with `op inject`. Secrets are op:// references into the
# Homelab vault; everything else is a literal.
APPDATA=/mnt/user/appdata
TZ=Europe/London

# Shared by Seafile, SeaDoc and the notification server
SEAFILE_JWT_PRIVATE_KEY=op://Homelab/SEAFILE_JWT_PRIVATE_KEY/password

SEAFILE_DB_PASS=op://Homelab/SEAFILE_DB_PASS/password
SEAFILE_DB_ROOT_PASS=op://Homelab/SEAFILE_DB_ROOT_PASS/password
SEAFILE_REDIS_PASS=op://Homelab/SEAFILE_REDIS_PASS/password

# The seafevents.conf token is `echo -n "seasearch:<this>" | base64`
SEASEARCH_ADMIN_PASS=op://Homelab/SEASEARCH_ADMIN_PASS/password
